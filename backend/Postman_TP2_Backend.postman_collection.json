        {
          "name": "Auth",
          "item": [
            {
              "name": "POST /auth/registro",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Maria\",\n  \"apellido\": \"Lopez\",\n  \"dni\": \"44556677\",\n  \"email\": \"mlopez@test.com\",\n  \"password\": \"password123\",\n  \"fecha_nacimiento\": \"1995-03-20\",\n  \"id_cobertura\": 1,\n  \"telefono\": \"3424999888\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/registro",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "registro"]
                },
                "description": "Registra un nuevo usuario con rol paciente. La contraseña se almacena hasheada con bcrypt."
              },
              "response": []
            },
            {
              "name": "POST /auth/registro CAMPOS FALTANTES (espera 400)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Ruiz\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/registro",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "registro"]
                },
                "description": "Intento de registro sin los campos requeridos. Debe devolver 400 con mensaje de error."
              },
              "response": []
            },
            {
              "name": "POST /auth/registro DNI DUPLICADO (espera 400)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Otro\",\n  \"apellido\": \"Usuario\",\n  \"dni\": \"44556677\",\n  \"email\": \"otro@test.com\",\n  \"password\": \"password123\",\n  \"fecha_nacimiento\": \"1990-01-01\",\n  \"id_cobertura\": 1,\n  \"telefono\": \"3424111222\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/registro",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "registro"]
                },
                "description": "Intento de registro con DNI ya existente. Debe devolver 400 indicando DNI duplicado. Requiere haber ejecutado POST /auth/registro primero."
              },
              "response": []
            },
            {
              "name": "POST /auth/login POSITIVO",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var json = pm.response.json();",
                      "if (json.datos && json.datos.token) {",
                      "    pm.collectionVariables.set('token', json.datos.token);",
                      "    console.log('Token guardado:', json.datos.token);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"dni\": \"44556677\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/login",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "login"]
                },
                "description": "Login exitoso con el usuario registrado en POST /auth/registro (rol paciente). Devuelve 200 con el JWT. El token se guarda automáticamente en la variable {{token}} de la colección, reutilizada también en los casos negativos de Semana 2."
              },
              "response": []
            },
            {
              "name": "POST /auth/login NEGATIVO",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"dni\": \"99887766\",\n  \"password\": \"12345678\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/login",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "login"]
                },
                "description": "Valida credenciales incorrectas. Espera error 401."
              },
              "response": []
            },
